@model CRM_Nexus_Retail.Models.Omni_Cliente

@{
    ViewBag.Title = "Editar Cliente";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <!-- ENCABEZADO -->
            <div class="d-flex align-items-center mb-4">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary mr-3">
                    <i class="fa fa-arrow-left"></i> Volver
                </a>
                <div>
                    <h2 class="mb-0 text-warning"><i class="fa fa-pencil"></i> Modificar Cliente</h2>
                    <small class="text-muted">Actualizando información de: <strong>@Model.Nombre_Completo</strong></small>
                </div>
            </div>

            <!-- RESUMEN DE ERRORES -->
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <!-- TARJETA DEL FORMULARIO -->
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="fa fa-edit"></i> Edición de Datos</h5>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Edit", "Clientes", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.Id_Nexus_Cliente)

                        <!-- FILA 1: Código de Referencia y Nombre de Pila -->
                        <div class="form-row">
                            <div class="form-group col-md-4">
                                @Html.LabelFor(m => m.Codigo_Ref, new { @class = "font-weight-bold" })
                                @Html.TextBoxFor(m => m.Codigo_Ref, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Codigo_Ref, "", new { @class = "text-danger small" })
                            </div>
                            <div class="form-group col-md-8">
                                @Html.LabelFor(m => m.Nombre_Pila, new { @class = "font-weight-bold" })
                                @Html.TextBoxFor(m => m.Nombre_Pila, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Nombre_Pila, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <!-- FILA 2: Apellidos -->
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                @Html.LabelFor(m => m.Apellido_Paterno, new { @class = "font-weight-bold" })
                                @Html.TextBoxFor(m => m.Apellido_Paterno, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Apellido_Paterno, "", new { @class = "text-danger small" })
                            </div>
                            <div class="form-group col-md-6">
                                @Html.LabelFor(m => m.Apellido_Materno, new { @class = "font-weight-bold" })
                                @Html.TextBoxFor(m => m.Apellido_Materno, new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.Apellido_Materno, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <!-- FILA 3: Contacto -->
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                @Html.LabelFor(m => m.Correo_Contacto, new { @class = "font-weight-bold" })
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                                    </div>
                                    @Html.TextBoxFor(m => m.Correo_Contacto, new { @class = "form-control", type = "email" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Correo_Contacto, "", new { @class = "text-danger small" })
                            </div>
                            <div class="form-group col-md-6">
                                @Html.LabelFor(m => m.Linea_Directa, new { @class = "font-weight-bold" })
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fa fa-phone"></i></span>
                                    </div>
                                    @Html.TextBoxFor(m => m.Linea_Directa, new { @class = "form-control" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Linea_Directa, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <!-- FILA 4: Domicilio Fiscal -->
                        <div class="form-group">
                            @Html.LabelFor(m => m.Domicilio_Fiscal, new { @class = "font-weight-bold" })
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="fa fa-map-marker"></i></span>
                                </div>
                                @Html.TextBoxFor(m => m.Domicilio_Fiscal, new { @class = "form-control" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Domicilio_Fiscal, "", new { @class = "text-danger small" })
                        </div>

                        <!-- FILA 5: Saldo de Puntos, Estado y Observaciones -->
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                @Html.LabelFor(m => m.Saldo_Puntos, new { @class = "font-weight-bold" })
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fa fa-star text-warning"></i></span>
                                    </div>
                                    @Html.TextBoxFor(m => m.Saldo_Puntos, new { @class = "form-control", type = "number", min = "0" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Saldo_Puntos, "", new { @class = "text-danger small" })
                            </div>
                            <div class="form-group col-md-3">
                                @Html.LabelFor(m => m.Estado_Cuenta, new { @class = "font-weight-bold" })
                                <select class="form-control" name="Estado_Cuenta">
                                    <option value="true" @(Model.Estado_Cuenta ? "selected" : "")>Activo</option>
                                    <option value="false" @(!Model.Estado_Cuenta ? "selected" : "")>Inactivo</option>
                                </select>
                            </div>
                            <div class="form-group col-md-6">
                                @Html.LabelFor(m => m.Observaciones, new { @class = "font-weight-bold" })
                                @Html.TextAreaFor(m => m.Observaciones, new { @class = "form-control", rows = "2" })
                                @Html.ValidationMessageFor(m => m.Observaciones, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <hr />

                        <!-- BOTONES -->
                        <div class="d-flex justify-content-end">
                            <a href="@Url.Action("Index")" class="btn btn-secondary mr-2">
                                <i class="fa fa-times"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-warning px-4 font-weight-bold">
                                <i class="fa fa-refresh"></i> Actualizar Cliente
                            </button>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}