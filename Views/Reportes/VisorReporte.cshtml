@model System.Data.DataTable

@{
    ViewBag.Title = ViewBag.NombreReporte ?? "Reporte Gerencial";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2><i class="fas fa-file-invoice text-primary"></i> @ViewBag.NombreReporte</h2>
            <p class="text-muted mb-0">Parámetros aplicados: Mínimo 5 INNER JOINs y 5 Filtros Dinámicos</p>
        </div>
        <div>
            <button onclick="window.print();" class="btn btn-outline-secondary">
                <i class="fas fa-print"></i> Imprimir Reporte
            </button>
            <a href="@Url.Action("Index", "Clientes")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Volver a Clientes
            </a>
        </div>
    </div>

    <hr />

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped table-bordered mb-0">
                    <thead class="thead-dark bg-dark text-white">
                        <tr>
                            @if (Model != null && Model.Columns.Count > 0)
                            {
                                foreach (System.Data.DataColumn columna in Model.Columns)
                                {
                                    <th>@columna.ColumnName.Replace("_", " ")</th>
                                }
                            }
                            else
                            {
                                <th>Sin estructura</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Rows.Count > 0)
                        {
                            foreach (System.Data.DataRow fila in Model.Rows)
                            {
                                <tr>
                                    @foreach (var item in fila.ItemArray)
                                    {
                                        <td>@(item == DBNull.Value ? "—" : item.ToString())</td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(Model != null ? Model.Columns.Count : 1)" class="text-center py-5 text-muted">
                                    <i class="fas fa-search fa-3x mb-3 d-block"></i>
                                    No se encontraron registros con los filtros seleccionados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3 text-muted text-right">
        <small>Total de registros devueltos: <strong>@(Model != null ? Model.Rows.Count : 0)</strong></small>
    </div>
</div>